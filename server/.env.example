# Server Environment Variables
PORT=5000
NODE_ENV=production

# JWT Authentication Configuration
JWT_ACCESS_SECRET=change-this-to-a-very-strong-access-secret-key
JWT_REFRESH_SECRET=change-this-to-a-very-strong-refresh-secret-key
ACCESS_EXPIRY=15m
REFRESH_EXPIRY=7d

# Frontend CORS Origin URL (Set to your Vercel URL in Production)
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Payment Gateway Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Database URL (MySQL Prisma Connection String)
# For local MySQL: "mysql://root:password@localhost:3306/ecommerce"
# For Aiven / Cloud MySQL: "mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?sslaccept=accept_invalid_certs&connection_limit=3"
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME"